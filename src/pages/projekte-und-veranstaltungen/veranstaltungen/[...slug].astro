---
import { getCollection, render } from 'astro:content';
import ContentImage from '../../../components/ContentImage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../i18n/ui';
import { formatDateTime } from '../../../i18n/utils';
import { site } from '../../../data/site.ts';

export async function getStaticPaths() {
  const events = await getCollection('veranstaltungen', ({ data }) => !data.draft);
  return events.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = ui.de;
const d = entry.data;

// Strukturierte Daten: Event. Ermöglicht Termin-Rich-Results in der Google-Suche.
const eventUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd: Record<string, unknown> = {
  '@type': 'Event',
  name: d.titel,
  startDate: d.start.toISOString(),
  ...(d.ende && { endDate: d.ende.toISOString() }),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: d.ort },
  description: d.kurzbeschreibung,
  url: eventUrl,
  // `bild` ist entweder ImageMetadata (optimiert) oder ein Pfad in public/ –
  // fuer die absolute URL beide Faelle auf einen String bringen.
  ...(d.bild && {
    image: new URL(typeof d.bild === 'string' ? d.bild : d.bild.src, Astro.site).href,
  }),
  organizer: { '@type': 'Organization', name: site.name, url: site.url },
  ...(d.anmeldungUrl && {
    offers: { '@type': 'Offer', url: d.anmeldungUrl, availability: 'https://schema.org/InStock' },
  }),
};
---

<BaseLayout title={d.titel} description={d.kurzbeschreibung} jsonLd={jsonLd}>
  <article class="container article">
    <p class="article__back">
      <a href="/projekte-und-veranstaltungen/veranstaltungen">← {t['back']}</a>
    </p>
    <h1>{d.titel}</h1>

    <dl class="facts">
      <div>
        <dt>{t['event.when']}</dt>
        <dd>
          <time datetime={d.start.toISOString()}>{formatDateTime(d.start)}</time>
          {d.ende && <> – <time datetime={d.ende.toISOString()}>{formatDateTime(d.ende)}</time></>}
        </dd>
      </div>
      <div>
        <dt>{t['event.where']}</dt>
        <dd>{d.ort}</dd>
      </div>
    </dl>

    <p class="article__teaser">{d.kurzbeschreibung}</p>
    {
      d.bild && (
        <ContentImage
          class="article__image"
          src={d.bild}
          alt={d.titel}
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 42rem, 100vw"
          loading="eager"
        />
      )
    }
    <div class="prose flow">
      <Content />
    </div>

    {
      d.anmeldungUrl && (
        <p class="cta">
          <a class="btn btn--primary" href={d.anmeldungUrl} rel="noopener">
            {t['event.register']}
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-16);
    max-width: var(--measure);
  }
  .article__back {
    margin-bottom: var(--space-6);
  }
  .article__back a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .facts {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--c-surface);
    border-radius: var(--radius);
  }
  @media (min-width: 30rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .facts dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-300);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }
  .facts dd {
    margin: 0;
  }
  .article__teaser {
    font-size: var(--fs-500);
    color: var(--c-muted);
    margin-bottom: var(--space-8);
  }
  .article__image {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: var(--space-8);
    border-radius: var(--radius);
  }
  .cta {
    margin-top: var(--space-8);
  }
</style>
