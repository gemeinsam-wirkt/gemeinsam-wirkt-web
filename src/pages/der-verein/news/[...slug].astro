---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../i18n/ui';
import { formatDate } from '../../../i18n/utils';
import { site } from '../../../data/site.ts';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = ui.de;
const d = entry.data;

// Strukturierte Daten: NewsArticle. Verein als Autor/Herausgeber inkl. Logo.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd: Record<string, unknown> = {
  '@type': 'NewsArticle',
  headline: d.titel,
  datePublished: d.datum.toISOString(),
  description: d.teaser,
  mainEntityOfPage: pageUrl,
  ...(d.bild && { image: new URL(d.bild.src, Astro.site).href }),
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: new URL(site.logo, Astro.site).href },
  },
};
---

<BaseLayout title={d.titel} description={d.teaser} jsonLd={jsonLd}>
  <article class="container article">
    <p class="article__back"><a href="/der-verein/news">← {t['back']}</a></p>
    <p class="article__date">{formatDate(entry.data.datum)}</p>
    <h1>{entry.data.titel}</h1>
    <p class="article__teaser">{entry.data.teaser}</p>
    {
      entry.data.bild && (
        <Image
          class="article__image"
          src={entry.data.bild}
          alt={entry.data.titel}
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 42rem, 100vw"
          loading="eager"
        />
      )
    }
    <div class="prose flow">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-16);
    max-width: var(--measure);
  }
  .article__back {
    margin-bottom: var(--space-6);
  }
  .article__back a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .article__date {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-muted);
    font-size: var(--fs-300);
  }
  .article h1 {
    margin-top: var(--space-2);
  }
  .article__teaser {
    margin-block: var(--space-4) var(--space-8);
    font-size: var(--fs-500);
    color: var(--c-muted);
  }
  .article__image {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: var(--space-8);
    border-radius: var(--radius);
  }
</style>
