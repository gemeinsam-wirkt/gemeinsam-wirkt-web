---
import PageLayout from '../layouts/PageLayout.astro';

/*
  Spenden per Überweisung (Bankverbindung).
  Wichtig: Der Verein ist NICHT gemeinnützig → keine steuerlich absetzbare
  Spendenbescheinigung, und betterplace scheidet aus (setzt Gemeinnützigkeit voraus).
  Mögliche Online-Ergänzung: goodcrowd.org (gut.org gAG, Berlin/DSGVO, auch für
  nicht-gemeinnützige Initiativen, nur verlinkbare Projektseite, kein Widget).
  Zum Nachrüsten Kampagne anlegen, GOODCROWD_URL setzen und den Block unten aktivieren.
*/

// goodcrowd-Kampagnenseite des Vereins (bei Aktivierung vollständige URL eintragen).
// const GOODCROWD_URL = 'https://www.goodcrowd.org/...';

// Bankverbindung des Vereins.
const bank = {
  inhaber: 'gemeinsam wirkt e.V.',
  iban: 'DE68 6835 1865 0108 9060 09',
  bic: 'SOLADES1MGL',
  institut: 'Sparkasse Markgräflerland',
  zweck: 'Spende',
};
---

<PageLayout
  title="Spenden"
  narrow
  lead="Kooperationsräume entstehen nicht von selbst. Mit deiner Spende sorgst du dafür, dass Menschen Zusammenarbeit erproben können."
>
  <div class="prose flow">
    <p>
      Vielleicht kennst du das Gefühl, etwas bewegen zu wollen, aber nicht zu wissen,
      wo du anfangen sollst. Eine Spende ist ein guter Anfang: Sie macht aus einer Idee
      einen Raum, in dem Menschen ins gemeinsame Tun kommen.
    </p>
    <p>
      Jeder Beitrag hilft – ob einmalig oder regelmäßig. Wir gehen sorgsam damit um und
      zeigen dir gern, was deine Spende konkret bewirkt.
    </p>

    {/*
      Online spenden – geparkt, bis eine goodcrowd-Kampagne angelegt ist.
      Zum Aktivieren GOODCROWD_URL oben setzen und diesen Block einkommentieren.

    <h2>Online spenden</h2>
    <p>
      Lieber online? Über goodcrowd kannst du bequem per Karte, PayPal oder Lastschrift
      beitragen.
    </p>
    <p>
      <a class="btn btn--primary" href={GOODCROWD_URL} rel="noopener" target="_blank">
        Über goodcrowd spenden
      </a>
    </p>
    */}

    <h2>So kannst du spenden</h2>
    <p>
      Überweis deinen Beitrag einfach direkt auf unser Vereinskonto.
    </p>
    <dl class="bank">
      <div>
        <dt>Kontoinhaber</dt>
        <dd>{bank.inhaber}</dd>
      </div>
      <div>
        <dt>IBAN</dt>
        <dd>{bank.iban}</dd>
      </div>
      <div>
        <dt>BIC</dt>
        <dd>{bank.bic}</dd>
      </div>
      <div>
        <dt>Bank</dt>
        <dd>{bank.institut}</dd>
      </div>
      <div>
        <dt>Verwendungszweck</dt>
        <dd>{bank.zweck}</dd>
      </div>
    </dl>
  </div>
</PageLayout>

<style>
  .bank {
    display: grid;
    gap: var(--space-4);
  }
  .bank dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-300);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }
  .bank dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
