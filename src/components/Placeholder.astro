---
/*
  Generische Platzhalter-Kachel für noch leere Bereiche (Projekte,
  Veranstaltungen, Podcasts). Zeigt ein schlichtes Symbol statt eines Fotos,
  bis echte Inhalte gepflegt sind. Bewusst nicht verlinkt.
*/
interface Props {
  /** Wählt das Symbol passend zum Bereich. */
  icon: 'kooperation' | 'termin' | 'podcast';
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---

<article class="ph">
  <div class="ph__icon" aria-hidden="true">
    {
      icon === 'kooperation' && (
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="16" r="6" />
          <circle cx="36" cy="16" r="6" />
          <circle cx="24" cy="34" r="6" />
          <line x1="18" y1="16" x2="30" y2="16" />
          <line x1="16.5" y1="20.5" x2="21" y2="29" />
          <line x1="31.5" y1="20.5" x2="27" y2="29" />
        </svg>
      )
    }
    {
      icon === 'termin' && (
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="8" y="11" width="32" height="29" rx="3" />
          <line x1="8" y1="19" x2="40" y2="19" />
          <line x1="16" y1="6" x2="16" y2="13" />
          <line x1="32" y1="6" x2="32" y2="13" />
          <circle cx="24" cy="30" r="2.5" fill="currentColor" stroke="none" />
        </svg>
      )
    }
    {
      icon === 'podcast' && (
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="18" y="6" width="12" height="22" rx="6" />
          <path d="M12 22a12 12 0 0 0 24 0" />
          <line x1="24" y1="34" x2="24" y2="40" />
          <line x1="18" y1="40" x2="30" y2="40" />
        </svg>
      )
    }
  </div>
  <h3 class="ph__title">{title}</h3>
  <p class="ph__text">{text}</p>
</article>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-8);
    background: var(--c-surface);
    border: 2px dashed var(--c-border);
    border-radius: var(--radius);
  }
  .ph__icon {
    color: var(--c-green-500);
  }
  .ph__icon svg {
    width: 48px;
    height: 48px;
  }
  .ph__title {
    margin: 0;
    font-size: var(--fs-500);
    color: var(--c-blue-900);
  }
  .ph__text {
    margin: 0;
    color: var(--c-muted);
  }
</style>
