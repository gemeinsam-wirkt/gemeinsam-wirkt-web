---
/*
  Newsletter-Anmeldung per mailto (CLAUDE.md Abschnitt 5).
  Bewusst ohne Backend/ESP: Ein Klick öffnet das Mailprogramm des Besuchers mit
  einer vorbereiteten Nachricht an den Verein. Die vom Besucher selbst gesendete
  E-Mail dokumentiert die Einwilligung; der Verein bestätigt per Antwort das
  Double-Opt-In. Passt zum Leitprinzip „wartungsarm, keine beweglichen Teile".
*/
import { ui } from '../i18n/ui';
const t = ui.de;

// Zieladresse der Newsletter-Anmeldung. Muss als echtes Postfach existieren
// (Hetzner konsoleH → E-Mail). Bei Änderung nur diese Zeile anpassen.
const NEWSLETTER_EMAIL = 'newsletter@gemeinsam-wirkt.net';

const mailtoHref =
  `mailto:${NEWSLETTER_EMAIL}` +
  `?subject=${encodeURIComponent(t['newsletter.mailto.subject'])}` +
  `&body=${encodeURIComponent(t['newsletter.mailto.body'])}`;
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter__text">
    <h2 id="newsletter-title">{t['newsletter.title']}</h2>
    <p>{t['newsletter.text']}</p>
  </div>

  <div class="newsletter__action">
    <a class="btn btn--primary" href={mailtoHref}>{t['newsletter.submit']}</a>
    <p class="newsletter__note">{t['newsletter.note']}</p>
  </div>
</section>

<style>
  .newsletter {
    display: grid;
    gap: var(--space-8);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-8);
  }
  @media (min-width: 48rem) {
    .newsletter {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-12);
    }
  }

  .newsletter h2 {
    margin-bottom: var(--space-3);
  }

  .newsletter__action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .newsletter__note {
    font-size: var(--fs-300);
    color: var(--c-muted);
    max-width: 50ch;
  }
</style>
